<?xml version="1.0" encoding="utf-8"?>
<!-- gkd_pure 动画 logo: 菱形 + 三阶圆头条, 保留原版的轻微浮动动画 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="64dp"
            android:height="64dp"
            android:viewportWidth="64"
            android:viewportHeight="64">
            <group android:name="diamond">
                <path
                    android:fillColor="#FFF"
                    android:pathData="M32,7 L41,16 L32,25 L23,16 Z" />
            </group>
            <group android:name="bar_left">
                <path
                    android:fillColor="#FFF"
                    android:pathData="M12,39 A5,5 0 0 1 22,39 L22,53 A5,5 0 0 1 12,53 Z" />
            </group>
            <path
                android:name="bar_mid"
                android:fillColor="#FFF"
                android:pathData="M27,33 A5,5 0 0 1 37,33 L37,53 A5,5 0 0 1 27,53 Z" />
            <group android:name="bar_right">
                <path
                    android:fillColor="#FFF"
                    android:pathData="M42,39 A5,5 0 0 1 52,39 L52,53 A5,5 0 0 1 42,53 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="diamond">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="translateY"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0"
                android:valueTo="-1.2"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="translateY"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0"
                android:valueTo="0.8"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar_mid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="fillAlpha"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0.75"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="translateY"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0"
                android:valueTo="0.8"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
